          "title": "Lookup suksessrate (%)",
          "scorecard": {
            "timeSeriesQuery": {
              "prometheusQuery": "100 * sum(rate({__name__=\"prometheus.googleapis.com/building_info_service_lookup_requests_total/counter\",cluster=~\"cloud-run-energinokkelen(-prod)?\",result=\"success\"}[5m])) / clamp_min(sum(rate({__name__=\"prometheus.googleapis.com/building_info_service_lookup_requests_total/counter\",cluster=~\"cloud-run-energinokkelen(-prod)?\"}[5m])), 0.001)"
            },
            "gaugeView": {
              "lowerBound": 0,
              "upperBound": 100
            },
            "thresholds": [
              {
                "label": "Warning",
                "value": 95,
                "color": "YELLOW",
                "direction": "BELOW"
              },
              {
                "label": "Critical",
                "value": 90,
                "color": "RED",
                "direction": "BELOW"
              }
            ]
          }
        }
